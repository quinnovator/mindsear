# Copy to .env; `npm run dev` and `npm start` load it automatically.

# Model access: set one. ANTHROPIC_API_KEY wins when both are set.
# Without either, the built-in course still works (code-graded answers, scripted tutor
# messages), but new objectives can't be compiled and free-text answers can't be graded.
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Override the model for a single role, e.g. MODEL_TUTOR=claude-sonnet-5-5.
# Roles: tutor, assessor, planner, item_writer, verifier, ingester, scoper, researcher,
# curriculum, misconceptions, templates, cross_checker, red_teamer.
# MODEL_TUTOR=

# Server
# HOST=127.0.0.1
# PORT=8787
# DB_PATH=./data/mindsear.db

# Identity. Without AUTH_HEADER the app is single-user (LOCAL_USER); only expose it beyond
# localhost behind a proxy that authenticates users and sets AUTH_HEADER on every request.
# LOCAL_USER=learner@localhost
# AUTH_HEADER=Tailscale-User-Login
# AUTH_NAME_HEADER=Tailscale-User-Name
